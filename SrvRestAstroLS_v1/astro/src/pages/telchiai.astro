---
import Team360Logo from "../components/marketing/Team360Logo.astro";
import TelchiAIHome from "../components/telchiai/TelchiAIHome.svelte";
import "../styles/global.css";
---

<!doctype html>
<html lang="es" data-theme="team360">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TelchiAI, asistente conversacional de negocios de Telchi." />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7fafb" />
    <title>TelchiAI | Team360</title>
  </head>
  <body class="min-h-screen bg-[#f7fafb] text-[#143653] antialiased">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#102d4f] focus:shadow-lg"
      href="#contenido-telchiai"
    >
      Saltar al contenido
    </a>
    <div class="border-b border-[#e4ebec] bg-white/80">
      <div class="mx-auto flex h-16 max-w-6xl items-center px-4 sm:h-[4.5rem] sm:px-8">
        <Team360Logo compact={true} size="small" />
      </div>
    </div>
    <TelchiAIHome client:load />
  </body>
</html>

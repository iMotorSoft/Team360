            {
              "sql": "SELECT min(\"payment_date\") AS first_observed_date,max(\"payment_date\") AS last_observed_date,count(*) AS dataset_rows FROM op_source",
              "parameters": []
            },
            {
              "sql": "CREATE OR REPLACE TEMP TABLE op_period AS SELECT * FROM op_source WHERE \"payment_date\">=? AND \"payment_date\"<?",
              "parameters": [
                "2026-10-01",
                "2026-11-01"
              ]
            },
            {
              "sql": "SELECT 'BS' AS currency,count(*) AS payments,\n                        count(DISTINCT customer_code) AS customers,\n                        sum(cast(payment_total AS DECIMAL(38,12))) AS amount\n                        FROM op_period WHERE cancelled='N' AND currency='BS' HAVING count(*)>0",
              "parameters": []
            },
            {
              "sql": "SELECT count(*) FILTER(WHERE cancelled<>'N' OR cancelled IS NULL) AS excluded_nonactive_payments,\n                        count(*) FILTER(WHERE cancelled='N' AND (currency<>'BS' OR currency IS NULL)) AS excluded_other_currency_payments FROM op_period",
              "parameters": []
            }
          ]

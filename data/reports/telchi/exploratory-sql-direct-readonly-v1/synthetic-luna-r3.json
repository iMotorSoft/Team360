      "output_text": "{\"action\":\"query\",\"sql\":\"WITH line_totals AS (SELECT invoice_id, sum(amount) AS line_amount FROM lines GROUP BY invoice_id), movement_totals AS (SELECT invoice_id, count(*) AS movement_rows, sum(quantity) AS movement_quantity FROM movements WHERE invoice_id IS NOT NULL GROUP BY invoice_id) SELECT i.id AS invoice_id, i.channel_id, i.seller_id, i.amount AS header_amount_bs, l.line_amount, m.movement_rows, m.movement_quantity FROM invoices i LEFT JOIN line_totals l ON i.id = l.invoice_id LEFT JOIN movement_totals m ON i.id = m.invoice_id ORDER BY i.id LIMIT 100\",\"objective\":\"Cuantificar cada factura a grano documental y separar cabecera, líneas y movimientos, incluyendo facturas sin canal.\",\"justification\":\"La observación previa mostró una fila agregada con canal nulo y un total de cabeceras; ahora se necesita identificar las facturas concretas y evitar multiplicación mediante agregaciones previas por factura.\",\"requested_sources\":[\"invoices\",\"lines\",\"movements\"],\"expected_grain\":\"una fila por factura\",\"expected_result\":\"Facturas con importe de cabecera, suma de líneas y conteo/cantidad de movimientos asociados de forma investigativa.\",\"candidate_relations\":[{\"left_table\":\"invoices\",\"left_column\":\"id\",\"right_table\":\"lines\",\"right_column\":\"invoice_id\",\"rationale\":\"relación declarada para agregar líneas por factura\"},{\"left_table\":\"invoices\",\"left_column\":\"id\",\"right_table\":\"movements\",\"right_column\":\"invoice_id\",\"rationale\":\"relación investigativa para comprobar multiplicación y asociación de movimientos\"}]}",
